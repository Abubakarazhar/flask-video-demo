# Factory Safety Monitoring System - Environment Configuration
# Copy this file to .env and fill in your values

# OpenAI API Configuration
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Vision Model Configuration (optional - uses defaults if not set)
VLM_PROVIDER=openai
VLM_MODEL=gpt-4o

# Reasoning Model Configuration (optional)
REASONING_PROVIDER=openai
REASONING_MODEL=gpt-4o

# Note: If no API key is provided, the system will run in MOCK mode
# This is useful for testing the pipeline without incurring API costs
